{
  "name": "@lism-css/icons",
  "version": "0.3.0",
  "description": "SVG icons for React and Astro.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist",
    "packages/astro/*.astro",
    "packages/astro/index.ts",
    "LICENSE"
  ],
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "import": "./dist/react/*.js"
    },
    "./astro": {
      "import": "./packages/astro/index.ts"
    },
    "./astro/*": "./packages/astro/*.astro",
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    }
  },
  "scripts": {
    "sync:design": "node scripts/sync-design.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "pnpm generate && pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && astro check --tsconfig packages/astro/tsconfig.json",
    "test": "pnpm build && node --test scripts/*.test.mjs",
    "lint": "eslint scripts/*.mjs src/react packages/astro src/data.ts",
    "format": "prettier --write scripts/*.mjs package.json tsconfig*.json",
    "prepare": "husky",
    "prepack": "pnpm build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "astro": "^5 || ^6",
    "@types/react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://lism-css.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/lism-css/icons.git"
  },
  "bugs": {
    "url": "https://github.com/lism-css/icons/issues"
  },
  "devDependencies": {
    "svgo": "4.0.2",
    "typescript": "~5.9.3",
    "astro": "^6.4.8",
    "@astrojs/check": "^0.9.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@types/react": "^19.2.17",
    "@types/node": "^25.9.4",
    "esbuild": "^0.28.1",
    "@eslint/js": "^9.39.4",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.62.1"
  }
}
